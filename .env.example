# Copy this file to ".env" and fill in the values. Never commit ".env".

# Address printed by colab_server.ipynb after you run it (it changes each Colab session)
COLAB_URL=

# API key printed by colab_server.ipynb
COLAB_KEY=

# Optional: free key from https://nvd.nist.gov/developers/request-an-api-key
# Without it, NVD may block the CVE tool's parallel requests.
NVD_API_KEY=
